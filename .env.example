# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- ClickHouse Cloud (used by mcp-clickhouse) ---
CLICKHOUSE_HOST=your-service.region.cloud-provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=30
# Keep false by default (least privilege). The ingestion process overrides this
# to true only for its own spawned mcp-clickhouse instance — see backend/ingest.
CLICKHOUSE_ALLOW_WRITE_ACCESS=false

# --- Google Cloud / ADK (Gemini) ---
# Plain Gemini Developer API key (aistudio.google.com) — no GCP billing
# account required. Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=
GEMINI_MODEL_PRINCIPAL=gemini-3.5-flash
GEMINI_MODEL_BACKGROUND=gemini-flash-lite-latest
